# 자산관리 플랫폼 환경변수. .env 로 복사 후 채우기 (.env 는 gitignore)

# ── 기본
NODE_ENV=development
PORT=3001
SESSION_SECRET=changeme-run-openssl-rand-hex-32
AUTH_PEPPER=changeme-run-openssl-rand-hex-16

# ── DB (1단계 SQLite)
DATABASE_URL="file:./prisma/dev.db"

# ── 저장소
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# ── Kakao Maps (.env 에 실제 키. 평문 노출 금지)
KAKAO_JS_KEY=
KAKAO_REST_KEY=

# ── CORS
CORS_ORIGIN=http://localhost:5173

# ── 시드 admin (1회 사용 후 사용자가 즉시 변경)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
